 \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u0430\u0441\u0438\u043b\u0438\u0435 \u0441\u043e \u0441\u0442\u043e\u0440\u043e\u043d\u044b \u043c\u0443\u0436\u0430/\u043f\u0430\u0440\u0442\u043d\u0451\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u043e \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0438\u043b\u0438 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u044b\u043c\u0438 \u043d\u043e\u0440\u043c\u0430\u043c\u0438.                                                            \u0422\u043e\u043b\u0435\u0440\u0430\u043d\u0442\u043d\u043e\u0441\u0442\u044c \u043a \u043d\u0430\u0441\u0438\u043b\u0438\u044e (\u043f\u0440\u0438\u043d\u044f\u0442\u0438\u0435 \u043d\u0430\u0441\u0438\u043b\u0438\u044f)                                   \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u0430\u044f \u0438\u043b\u0438 \u043b\u0438\u0447\u043d\u0430\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430, \u0441\u043e\u0433\u043b\u0430\u0441\u043d\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u043c \u043f\u0440\u0438\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u043d\u0430\u0441\u0438\u043b\u0438\u044f \u0432 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u044b\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f\u0445. \u0412 \u0434\u0430\u043d\u043d\u043e\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u2014 \u0436\u0435\u043d\u0449\u0438\u043d\u044b, \u0441\u0447\u0438\u0442\u0430\u044e\u0449\u0438\u0435, \u0447\u0442\u043e \u043c\u0443\u0436\u0447\u0438\u043d\u0430 \u0432\u043f\u0440\u0430\u0432\u0435 \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u0436\u0435\u043d\u0443 \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u043b\u0438 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u0438\u043c \u0438\u0437 \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u044b\u0445 \u043f\u0440\u0438\u0447\u0438\u043d.","rationale_interpretation":"\u041a\u041e\u041c\u041f 2023 \u0431\u044b\u043b\u043e \u043e\u0446\u0435\u043d\u0435\u043d\u043e \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 \u0436\u0435\u043d\u0449\u0438\u043d \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 15-49 \u043b\u0435\u0442 \u043a \u0438\u0437\u0431\u0438\u0435\u043d\u0438\u044e \u0436\u0435\u043d\u044b/\u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0448\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u043e \u0442\u043e\u043c, \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u043b\u0438 \u0440\u0435\u0441\u043f\u043e\u043d\u0434\u0435\u043d\u0442\u044b \u0438\u0437\u0431\u0438\u0435\u043d\u0438\u0435 \u043c\u0443\u0436\u044c\u044f\u043c\u0438/\u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0430\u043c\u0438 \u0441\u0432\u043e\u0438\u0445 \u0436\u0435\u043d/\u043f\u0430\u0440\u0442\u043d\u0435\u0440\u0448 \u0432 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u044b\u0445 \u0441\u0438\u0442\u0430\u0446\u0438\u044f\u0445 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u043d\u044b\u043c\u0438. \u0426\u0435\u043b\u044c \u044d\u0442\u0438\u0445 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f \u0432 \u0444\u0438\u043a\u0441\u0430\u0446\u0438\u0438 \u043e\u043f\u0440\u0430\u0432\u0434\u0430\u043d\u0438\u044f \u043d\u0430\u0441\u0438\u043b\u0438\u044f \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c (\u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445, \u0433\u0434\u0435 \u0436\u0435\u043d\u0449\u0438\u043d\u044b \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u043e\u0431\u043b\u0430\u0434\u0430\u044e\u0442 \u0431\u043e\u043b\u0435\u0435 \u043d\u0438\u0437\u043a\u0438\u043c \u0441\u0442\u0430\u0442\u0443\u0441\u043e\u043c) \u0432 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u043c\u0435\u0440\u044b \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u0430\u0440\u043d\u043e\u0433\u043e \u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0432 \u0441\u043b\u0443\u0447\u0430\u044f\u0445, \u043a\u043e\u0433\u0434\u0430 \u0436\u0435\u043d\u0449\u0438\u043d\u0430 \u043d\u0435 \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0435\u0442 \u043e\u043f\u0440\u0435\u0434\u0435\u043d\u043d\u044b\u0435 \u043e\u0436\u0438\u0434\u0430\u0435\u043c\u044b\u0435 \u0433\u0435\u043d\u0434\u0435\u0440\u043d\u044b\u0435 \u0440\u043e\u043b\u0438.","data_sources":"\u041a\u043b\u0430\u0441\u0442\u0435\u0440\u043d\u043e\u0435 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e \u043c\u043d\u043e\u0433\u0438\u043c \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044f\u043c (\u041a\u041e\u041c\u041f)","data_collection":"\u0414\u0430\u043d\u043d\u044b\u0435 \u0441\u043e\u0431\u0438\u0440\u0430\u043b\u0438\u0441\u044c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u043e\u043f\u0440\u043e\u0441\u0430. ","computation_methods":"\u041f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u0434\u043e\u043b\u044f \u0436\u0435\u043d\u0449\u0438\u043d \u0432 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0435 15\u201349 \u043b\u0435\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0441\u0447\u0438\u0442\u0430\u044e\u0442 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u043c, \u0447\u0442\u043e \u043c\u0443\u0436 \u0438\u043c\u0435\u0435\u0442 \u043f\u0440\u0430\u0432\u043e \u0443\u0434\u0430\u0440\u0438\u0442\u044c \u0438\u043b\u0438 \u043f\u043e\u0431\u0438\u0442\u044c \u0441\u0432\u043e\u044e \u0436\u0435\u043d\u0443 \u043f\u043e \u043a\u0440\u0430\u0439\u043d\u0435\u0439 \u043c\u0435\u0440\u0435 \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043f\u0440\u0438\u0447\u0438\u043d: 1) \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u0438\u0442 \u0438\u0437 \u0434\u043e\u043c\u0430 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u0432 \u0435\u043c\u0443, 2) \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u043d\u0435 \u0437\u0430\u0431\u043e\u0442\u0438\u0442\u0441\u044f \u043e \u0434\u0435\u0442\u044f\u0445, 3)\u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u0432\u043e\u0437\u0440\u0430\u0436\u0430\u0435\u0442 \u0435\u043c\u0443, 4) \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0435\u043c\u0443 \u0432 \u043f\u043e\u043b\u043e\u0432\u043e\u0439 \u0431\u043b\u0438\u0437\u043e\u0441\u0442\u0438, 5) \u0435\u0441\u043b\u0438 \u0443 \u043d\u0435\u0435 \u043f\u0440\u0438\u0433\u043e\u0440\u0430\u0435\u0442 \u0435\u0434\u0430.","quality_assurance":"\u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0434\u0430\u043d\u043d\u044b\u0445 \u041a\u041e\u041c\u041f \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u043c\u0435\u0442\u043e\u0434\u043e\u043b\u043e\u0433\u0438\u0438, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0438, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u0438 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0441\u0442\u0438, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u044d\u0442\u0438 \u043e\u0431\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0430\u0434\u0435\u0436\u043d\u044b\u043c \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u043e\u043c \u0434\u043b\u044f \u0430\u043d\u0430\u043b\u0438\u0437\u0430 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u0435\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0433\u0435\u043d\u0434\u0435\u0440\u043d\u043e\u0435 \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u04