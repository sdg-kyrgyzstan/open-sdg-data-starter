{"goal_meta_link_text":"custom.meta_link_text","data_non_statistical":false,"graph_type":"line","indicator_name":"\u041a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u0414\u0436\u0438\u043d\u0438 (\u043f\u043e \u0434\u043e\u0445\u043e\u0434\u0430\u043c)","graph_title":"\u041a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u0414\u0436\u0438\u043d\u0438 (\u043f\u043e \u0434\u043e\u0445\u043e\u0434\u0430\u043c)","national_geographical_coverage":"\u041a\u044b\u0440\u0433\u044b\u0437\u0441\u043a\u0430\u044f \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0430","measurement_units":"\u0421\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435","tags":["custom.national"],"page_content":"","en":{"data_non_statistical":false,"graph_type":"line","indicator_name":"Gini coefficient (income)","graph_title":"Gini coefficient (income)","national_geographical_coverage":"Kyrgyz Republic","measurement_units":"Ratio","tags":["custom.national"],"page_content":""},"national_metadata_updated_date":"2026-08-11","goal_name":"\u0426\u0435\u043b\u044c 10: \u0421\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0438\u0435 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0432\u043d\u0443\u0442\u0440\u0438 \u0441\u0442\u0440\u0430\u043d \u0438 \u043c\u0435\u0436\u0434\u0443 \u043d\u0438\u043c\u0438","target_name":"10.4 \u041a 2030 \u0433\u043e\u0434\u0443 \u0441\u043f\u043e\u0441\u043e\u0431\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0435\u043d\u0438\u0435 \u0441\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e, \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438 \u043f\u043e\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0432\u0441\u0435\u0445, \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e \u043e\u0442 \u043f\u043e\u043b\u0430, \u0438\u043d\u0432\u0430\u043b\u0438\u0434\u043d\u043e\u0441\u0442\u0438, \u0440\u0430\u0441\u044b, \u044d\u0442\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u0439 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u043d\u043e\u0441\u0442\u0438, \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u044f, \u0440\u0435\u043b\u0438\u0433\u0438\u0438 \u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0441\u0442\u0430\u0442\u0443\u0441\u0430.","indicator_name1":"10.4.2.1. \u041a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u0414\u0436\u0438\u043d\u0438","organization_name":" \u041d\u0421\u041a \u041a\u0420","contact_name":"\u041a\u0430\u043b\u044b\u043c\u0431\u0435\u0442\u043e\u0432\u0430 \u042b.\u0418.","contact_email":"ykalymbetova@stat.kg","contact_phone":"(0312) 32 46 55","organization_website":"www.stat.gov.kg  ","definitions":"\u041a\u043e\u044d\u0444\u0444\u0438\u0446\u0438\u0435\u043d\u0442 \u043a\u043e\u043d\u0446\u0435\u043d\u0442\u0440\u0430\u0446\u0438\u0438 \u0434\u043e\u0445\u043e\u0434\u043e\u0432 (\u0418\u043d\u0434\u0435\u043a\u0441 \u0414\u0436\u0438\u043d\u0438)  \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u043e\u0442\u043a\u043b\u043e\u043d\u0435\u043d\u0438\u044f \u0444\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043e\u0431\u044a\u0435\u043c\u0430 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u0445\u043e\u0434\u043e\u0432 \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f \u043e\u0442 \u043b\u0438\u043d\u0438\u0438 \u0438\u0445 \u0440\u0430\u0432\u043d\u043e\u043c\u0435\u0440\u043d\u043e\u0433\u043e \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f.","concepts":"\u0418\u043d\u0434\u0435\u043a\u0441 \u0414\u0436\u0438\u043d\u0438 \u2014 \u044d\u0442\u043e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0439 \u0434\u043b\u044f \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f \u0441\u0442\u0435\u043f\u0435\u043d\u0438 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0434\u043e\u0445\u043e\u0434\u043e\u0432 \u0438\u043b\u0438 \u0431\u043e\u0433\u0430\u0442\u0441\u0442\u0432\u0430 \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435. \u041e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043e\u0442 0 \u0434\u043e 1, \u0433\u0434\u0435 0 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u043e\u043b\u043d\u043e\u043c\u0443 \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0443 (\u0432\u0441\u0435 \u0438\u043c\u0435\u044e\u0442 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0439 \u0434\u043e\u0445\u043e\u0434), \u0430 1 \u2014 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0443 (\u0432\u0435\u0441\u044c \u0434\u043e\u0445\u043e\u0434 \u0441\u043e\u0441\u0440\u0435\u0434\u043e\u0442\u043e\u0447\u0435\u043d \u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430).                                \u0420\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u0445\u043e\u0434\u043e\u0432 \u2014 \u0441\u043f\u043e\u0441\u043e\u0431, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043e\u0431\u0449\u0438\u0439 \u0434\u043e\u0445\u043e\u0434 \u0432 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d \u043c\u0435\u0436\u0434\u0443 \u0435\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u043c\u0438 \u0438\u043b\u0438 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438.\n\u041d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u043e \u2014 \u0441\u0442\u0435\u043f\u0435\u043d\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f \u0432 \u0434\u043e\u0445\u043e\u0434\u0430\u0445 \u0438\u043b\u0438 \u0431\u043b\u0430\u0433\u043e\u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0438 \u043c\u0435\u0436\u0434\u0443 \u0440\u0430\u0437\u043d\u044b\u043c\u0438 \u043b\u044e\u0434\u044c\u043c\u0438 \u0438\u043b\u0438 \u0433\u0440\u0443\u043f\u043f\u0430\u043c\u0438.\n\u041a\u0440\u0438\u0432\u0430\u044f \u041b\u043e\u0440\u0435\u043d\u0446\u0430 \u2014 \u0433\u0440\u0430\u0444\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u043e\u0435 \u0440\u0430\u0441\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0434\u043e\u0445\u043e\u0434\u043e\u0432 (\u0438\u043b\u0438 \u0431\u043e\u0433\u0430\u0442\u0441\u0442\u0432\u0430) \u043f\u043e \u0434\u043e\u043b\u044f\u043c \u043d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u044f, \u043e\u0442\u0441\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c \u043f\u043e \u0443\u0440\u043e\u0432\u043d\u044e \u0434\u043e\u0445\u043e\u0434\u0430.\n\u0418\u043d\u0434\u0435\u043a\u0441 \u0414\u0436\u0438\u043d\u0438 \u2014 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0435\u043b\u044c \u043d\u0435\u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043d\u0430 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u043c\u0435\u0436\u0434\u0443 \u043a\u0440\u0438\u0432\u043e\u0439 \u041b\u043e\u0440\u0435\u043d\u0446\u0430 \u0438 \u043b\u0438\u043d\u0438\u0435\u0439 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0440\u0430\u0432\u0435\u043d\u